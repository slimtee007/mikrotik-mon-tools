# ==========================================
# MikroTik Dashboard Environment Variables
# Rename this file to .env and fill in your details
# ==========================================

# 1. Dashboard Web Login
ADMIN_USER=admin
ADMIN_PASS=ChangeMeImmediately123!

# 2. MikroTik Router Connection
MIKROTIK_HOST=192.168.88.1
MIKROTIK_USER=admin
MIKROTIK_PASS=YourRouterPassword
MIKROTIK_PORT=8728
MIKROTIK_SSL=false

# 3. Billing Integration (Optional)
# Options: None, Paystack, Flutterwave, PalmPay
BILLING_PROVIDER=None
BILLING_KEY=
